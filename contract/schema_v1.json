{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contract/schema_v1.json",
  "title": "FlyBreak tick",
  "type": "object",
  "required": ["schema_version", "tick", "sim_time_ms", "stimulus", "activity", "motor_state", "meta", "world"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.6" },
    "tick": { "type": "integer", "minimum": 0 },
    "sim_time_ms": { "type": "number", "minimum": 0 },
    "stimulus": {
      "type": "object",
      "required": ["mood_level", "other_inputs"],
      "additionalProperties": false,
      "properties": {
        "mood_level": { "type": "number", "minimum": 0, "maximum": 1 },
        "other_inputs": { "type": "object" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["spike_count", "firing_rate_hz", "active_regions", "food_activity", "food_supply", "water_supply", "sample_spikes"],
      "additionalProperties": false,
      "properties": {
        "spike_count": { "type": "integer", "minimum": 0 },
        "firing_rate_hz": { "type": "number", "minimum": 0 },
        "active_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["region", "activity"],
            "additionalProperties": false,
            "properties": {
              "region": { "type": "string", "minLength": 1 },
              "activity": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "food_activity": { "type": "number", "minimum": 0, "maximum": 1 },
        "food_supply": { "type": "number", "minimum": 0, "maximum": 1 },
        "water_supply": { "type": "number", "minimum": 0, "maximum": 1 },
        "sample_spikes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "motor_state": {
      "type": "object",
      "required": ["action", "heading_deg", "speed", "wing_state", "position"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "enum": ["idle", "walking", "grooming", "flying", "frozen"] },
        "heading_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "speed": { "type": "number", "minimum": 0 },
        "wing_state": { "type": "string", "enum": ["folded", "raised", "buzzing"] },
        "position": {
          "type": "object",
          "required": ["x", "z"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "z": { "type": "number" }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["status", "notes"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["decompressing", "running", "paused", "error"] },
        "notes": { "type": "string" }
      }
    },
    "world": {
      "type": "object",
      "required": ["other_flies"],
      "additionalProperties": false,
      "properties": {
        "other_flies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "position", "heading_deg", "action", "wing_state"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 0 },
              "position": {
                "type": "object",
                "required": ["x", "z"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "z": { "type": "number" }
                }
              },
              "heading_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
              "action": { "type": "string", "enum": ["idle", "walking", "grooming", "flying", "frozen"] },
              "wing_state": { "type": "string", "enum": ["folded", "raised", "buzzing"] }
            }
          }
        }
      }
    }
  }
}
